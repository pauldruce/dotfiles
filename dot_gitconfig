[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = OneHalfDark
	default-language = bash
	wrap-max-lines = unlimited
	pager = ov -F --section-delimiter '^(commit|added:|removed:|renamed:|Δ)' --section-header --caption '[Tab] focus file  [n/N] next/prev  [l] file list  [w] wrap  [q] quit'
	file-style = "bold #cdd6f4"
	file-decoration-style = "#89b4fa" ul
	hunk-header-style = "syntax bold"
	hunk-header-decoration-style = omit
	hunk-header-file-style = "bold #a6adc8"
	hunk-header-line-number-style = "bold #fab387"
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[alias]
	sbs = -c delta.side-by-side=true diff
[include]
	path = ~/.gitconfig.local
